{
{%- if os() == "windows" %}
  "terminal.integrated.profiles.windows": {
    "Nushell": {
      "path": "nu.exe"
    }
  },
  "terminal.integrated.defaultProfile.windows": "Nushell",
{%- endif %}
  "stylua.searchBinaryInPATH": true,
  "C_Cpp.intelliSenseEngine": "disabled",
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[lua]": {
    "editor.defaultFormatter": "JohnnyMorganz.stylua"
  },
  "[python]": {
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    },
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "background.enabled": true,
  "background.fullscreen": {
    "images": [
      "https://raw.githubusercontent.com/doki-theme/doki-theme-assets/refs/heads/master/backgrounds/wallpapers/zero_two_obsidian.png",
      "https://raw.githubusercontent.com/doki-theme/doki-theme-assets/refs/heads/master/backgrounds/wallpapers/kanna_dark.png",
      "https://raw.githubusercontent.com/doki-theme/doki-theme-assets/refs/heads/master/backgrounds/wallpapers/ryuko_light.png"
    ],
    "interval": 0,
    "opacity": 0.1,
    "random": true
  },
  "chat.disableAIFeatures": true,
  "cmake.configureOnEdit": false,
  "cmake.configureOnOpen": false,
  "cmake.options.statusBarVisibility": "icon",
  "cmake.outputLogEncoding": "utf8",
  "cmake.pinnedCommands": [
    "workbench.action.tasks.configureTaskRunner",
    "workbench.action.tasks.runTask"
  ],
  "debugpy.debugJustMyCode": false,
  "debugpy.showPythonInlineValues": true,
  "diffEditor.hideUnchangedRegions.enabled": true,
  "editor.fontFamily": "Maple Mono NF CN",
  "editor.fontLigatures": true,
  "editor.fontSize": 20,
  "editor.fontWeight": "400",
  "editor.guides.bracketPairs": "active",
  "editor.peekWidgetDefaultFocus": "editor",
  "editor.renderWhitespace": "trailing",
  "extensions.experimental.affinity": {
    "vscodevim.vim": 1
  },
  "extensions.ignoreRecommendations": true,
  "gitlens.graph.layout": "editor",
  "gitlens.plusFeatures.enabled": false,
  "notebook.defaultFormatter": "charliermarsh.ruff",
  "notebook.lineNumbers": "on",
  "python.analysis.inlayHints.callArgumentNames": "partial",
  "python.analysis.inlayHints.functionReturnTypes": true,
  "python.analysis.inlayHints.variableTypes": true,
  "security.promptForLocalFileProtocolHandling": false,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.customGlyphs": false,
  "terminal.integrated.enableImages": true,
  "terminal.integrated.fontLigatures.enabled": true,
  "terminal.integrated.lineHeight": 1,
  "vim.camelCaseMotion.enable": true,
  "vim.enableNeovim": true,
  "vim.insertModeKeyBindingsNonRecursive": [
    {
      "before": ["c-j"],
      "commands": ["editor.action.triggerSuggest"],
      "silent": true
    },
    {
      "before": ["c-k"],
      "commands": ["editor.action.triggerParameterHints"],
      "silent": true
    },
    {
      "before": ["c-v"],
      "commands": ["editor.action.clipboardPasteAction"],
      "silent": true
    }
  ],
  "vim.leader": "<space>",
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": ["H"],
      "commands": ["workbench.action.previousEditor"],
      "silent": true
    },
    {
      "before": ["L"],
      "commands": ["workbench.action.nextEditor"],
      "silent": true
    },
    {
      "before": ["<leader>", "/"],
      "commands": ["search.action.openEditor"],
      "silent": true
    },
    {
      "before": ["<leader>", "f", "g"],
      "commands": ["workbench.action.quickTextSearch"],
      "silent": true
    },
    {
      "before": ["<leader>", "f", "d"],
      "commands": ["workbench.action.problems.focus"],
      "silent": true
    },
    {
      "before": ["<leader>", "f", "s"],
      "commands": ["workbench.action.gotoSymbol"],
      "silent": true
    },
    {
      "before": ["<leader>", "f", "f"],
      "commands": ["workbench.action.quickOpen"],
      "silent": true
    },
    {
      "before": ["<leader>", "a"],
      "commands": ["editor.action.quickFix"],
      "silent": true
    },
    {
      "before": ["<leader>", "r"],
      "commands": ["editor.action.rename"],
      "silent": true
    },
    {
      "before": ["g", "r"],
      "commands": ["editor.action.goToReferences"],
      "silent": true
    },
    {
      "before": ["g", "p", "d"],
      "commands": ["editor.action.peekDefinition"],
      "silent": true
    },
    {
      "before": ["g", "p", "r"],
      "commands": ["editor.action.referenceSearch.trigger"],
      "silent": true
    },
    {
      "before": ["g", "d"],
      "commands": ["editor.action.revealDefinition"],
      "silent": true
    },
    {
      "before": ["c-w", "g", "d"],
      "commands": ["editor.action.revealDefinitionAside"],
      "silent": true
    },
    {
      "before": ["c-i"],
      "commands": ["workbench.action.navigateForwardInNavigationLocations"],
      "silent": true
    },
    {
      "before": ["c-o"],
      "commands": ["workbench.action.navigateBackInNavigationLocations"],
      "silent": true
    },
    {
      "before": ["g", ","],
      "commands": ["workbench.action.navigateForwardInEditLocations"],
      "silent": true
    },
    {
      "before": ["g", ";"],
      "commands": ["workbench.action.navigateBackInEditLocations"],
      "silent": true
    },
    {
      "before": ["<leader>", "="],
      "commands": ["editor.action.formatDocument"],
      "silent": true
    },
    {
      "before": ["[", "c"],
      "commands": [
        "workbench.action.editor.previousChange",
        "workbench.action.compareEditor.previousChange"
      ],
      "silent": true
    },
    {
      "before": ["]", "c"],
      "commands": [
        "workbench.action.editor.nextChange",
        "workbench.action.compareEditor.nextChange"
      ],
      "silent": true
    },
    {
      "before": ["[", "d"],
      "commands": ["editor.action.marker.prev"],
      "silent": true
    },
    {
      "before": ["]", "d"],
      "commands": ["editor.action.marker.next"],
      "silent": true
    },
    {
      "before": ["<leader>", "n"],
      "commands": ["workbench.explorer.fileView.focus"],
      "silent": true
    },
    {
      "before": ["K"],
      "commands": ["editor.action.showHover"],
      "silent": true
    },
    {
      "before": ["g", "l"],
      "commands": ["editor.action.addSelectionToNextFindMatch"],
      "silent": true
    },
    {
      "before": ["g", "L"],
      "commands": ["editor.action.addSelectionToPreviousFindMatch"],
      "silent": true
    },
    {
      "before": ["d", "o"],
      "commands": ["git.diff.stageHunk"],
      "silent": true
    }
  ],
  "vim.showMarksInGutter": true,
  "vim.smartRelativeLine": true,
  "vim.substitutionTextColor": "#CBA6F7",
  "vim.visualModeKeyBindingsNonRecursive": [
    {
      "before": ["g", "l"],
      "commands": ["editor.action.addSelectionToNextFindMatch"],
      "silent": true
    },
    {
      "before": ["g", "L"],
      "commands": ["editor.action.addSelectionToPreviousFindMatch"],
      "silent": true
    },
    {
      "before": ["c-c"],
      "commands": ["editor.action.clipboardCopyAction"],
      "silent": true
    },
    {
      "before": [">"],
      "commands": ["editor.action.indentLines"],
      "silent": true
    },
    {
      "before": ["<"],
      "commands": ["editor.action.outdentLines"],
      "silent": true
    },
    {
      "before": ["J"],
      "commands": ["editor.action.moveLinesDownAction"],
      "silent": true
    },
    {
      "before": ["K"],
      "commands": ["editor.action.moveLinesUpAction"],
      "silent": true
    }
  ],
  "workbench.colorCustomizations": {
    "editorCursor.foreground": "#F5BDE6"
  },
  "workbench.colorTheme": "Catppuccin Mocha",
  "workbench.editor.useModal": "some",
  "workbench.experimental.modernUI": true,
  "workbench.iconTheme": "catppuccin-mocha"
}
