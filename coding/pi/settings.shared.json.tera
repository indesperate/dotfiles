{
  "theme": "catppuccin",
  "showHardwareCursor": true,
  "vimEditor": {
    "cursorShape": true
  },
  "defaultTools": [
    "+grep",
    "+find",
    "+ls",
    "+tool_search",
    "+codemode"{% if os() == "windows" %},
    "-bash",
    "+powershell"{% endif %}
  ],
  "packages": [
    {# Web search and URL fetching. #}
    "npm:pi-web-access",
    {# Native Starship-style footer, configured through /starship. #}
    "npm:@narumitw/pi-starship",
    {# Language learning with writing feedback and bilingual translations. #}
    "npm:pi-language-tutor",
    {# Provider usage, limits, balances, and Codex Fast mode. #}
    "npm:@narumitw/pi-usage",
    {# Transparent tool and user-message frames. #}
    "npm:pi-tidy",
    {# Vim-style editing; load after extensions that customize the editor. #}
    "npm:pi-vim-editor"
  ],
  "tidy": {
    "style": "frame",
    "userMessageFill": true,
    "messageBorderColors": {
      "user": "mdQuoteBorder"
    },
    "groupTools": false,
    "backgroundJobs": false,
    "codeBlocks": false,
    "finalReplyStyle": "rail",
    "replyMetrics": true
  }
}
